#!/usr/bin/env bash
# ruby-lsp launcher for Emacs (eglot).
#
# Two things Emacs cannot do for itself:
#
#   1. ruby-lsp has to run under the project's mise Ruby, with the matching
#      GEM_HOME/GEM_PATH. This is the launch strategy ruby-lsp documents for
#      version managers -- https://shopify.github.io/ruby-lsp/editors.html
#      lists `mise x -- ruby-lsp` first.
#
#   2. Bundler needs the Artifactory credential to resolve nedap.jfrog.io
#      gems, and it lives in 1Password. A GUI-launched Emacs has no shell
#      environment, so ~/.config/zsh never runs and the `tokens` function
#      never fires.
#
# Mirrors ~/.local/bin/zed-ruby-lsp. Point Zed's lsp.ruby-lsp.binary.path at
# this file to keep a single shim under version control.

set -eu

OP=/opt/homebrew/bin/op
MISE=/opt/homebrew/bin/mise
MKTEMP=/usr/bin/mktemp
CAT=/bin/cat
RM=/bin/rm
OP_ACCOUNT=your-account.1password.com
OP_REF='op://your-vault-uuid/jfrog/token'

# `op' stderr must not share a stream with the token. With `2>&1' inside the
# command substitution, anything op writes to stderr while still exiting 0 --
# an update banner, a deprecation notice -- was concatenated onto the token
# and exported as BUNDLE_NEDAP__JFROG__IO, resurfacing much later as an opaque
# Bundler 401 against nedap.jfrog.io. Capture it to a private file instead and
# splice it only into the failure message.
if op_err=$("$MKTEMP" "${TMPDIR:-/tmp}/mise-ruby-lsp.XXXXXX" 2>/dev/null); then
  op_err_sink=$op_err
else
  # Same rationale as the token failure below: never take the LSP down.
  op_err=
  op_err_sink=/dev/null
fi

if token=$("$OP" read --account "$OP_ACCOUNT" "$OP_REF" 2>"$op_err_sink"); then
  export BUNDLE_NEDAP__JFROG__IO="$token"
else
  # Not fatal: ruby-lsp is still useful in projects with no Artifactory
  # gems, and failing here would take the whole LSP session down. Eglot
  # collects this in the *EGLOT (<project>/ruby-ts-mode) stderr* buffer.
  # Everything here goes to stderr: stdout is the JSON-RPC stdio stream.
  echo "mise-ruby-lsp: could not read the JFrog token from 1Password" >&2
  if [ -n "$op_err" ]; then
    echo "mise-ruby-lsp: op said: $("$CAT" "$op_err")" >&2
  fi
  echo "mise-ruby-lsp: unlock the 1Password app and enable CLI integration" >&2
fi

# `exec' replaces this process image, so an EXIT trap would never fire.
if [ -n "$op_err" ]; then
  "$RM" -f "$op_err"
fi

exec "$MISE" exec -- ruby-lsp "$@"

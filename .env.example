# Copy this file to .env (it is gitignored) and fill in your own values.
# early-init.el loads it through my/load-dotenv, so a GUI Emacs sees these
# too, and bin/mise-ruby-lsp sources the same file itself.

# OpenRouter key for aidermacs
OPENROUTER_API_KEY=sk-or-your-actual-openrouter-key

# 1Password coordinates for lisp/my-op.el and bin/mise-ruby-lsp.
# OP_ACCOUNT matches `op account list`; OP_VAULT is the vault UUID from
# `op vault list'; each OP_<KEY>_ITEM is the item path below the vault.
# Quote a value when it contains spaces ("item section/field").
OP_ACCOUNT=your-account.1password.com
OP_VAULT=your-vault-uuid
OP_JFROG_ITEM=jfrog/token
OP_GITHUB_ITEM=github/token
